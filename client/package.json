{
  "name": "@ai-finance/client",
  "version": "0.1.0",
  "private": true,
  "description": "ai-finance Electron desktop client",
  "author": "hezihua",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "wait-on http://localhost:3000 && node scripts/with-electron-libs.cjs electron-vite dev",
    "build": "electron-vite build",
    "start": "node scripts/with-electron-libs.cjs electron-vite preview",
    "lint": "tsc --noEmit",
    "pack:win": "pnpm build && electron-builder --win --config electron-builder.yml -p never",
    "pack:dir": "pnpm build && electron-builder --win dir --config electron-builder.yml -p never"
  },
  "devDependencies": {
    "@types/node": "^20",
    "electron": "^35.7.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "typescript": "^5",
    "wait-on": "^8.0.5"
  }
}
