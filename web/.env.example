# 同花顺金融数据 API Key（https://fuyao.aicubes.cn/admin/）
HITHINK_FINANCE_API_KEY=

# 可选：自定义 API 基址
HITHINK_FINANCE_API_BASE=https://fuyao.aicubes.cn

# OpenRouter（AI 对话 / 分析，可选）
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324
# 主模型限流/地区不可用时按序回退（逗号分隔）
OPENROUTER_FALLBACK_MODELS=qwen/qwen-2.5-72b-instruct,meta-llama/llama-3.3-70b-instruct
OPENROUTER_HTTP_REFERER=http://localhost:3000
# 生产环境改为 Vercel 域名，例如 https://ai-finance-xxx.vercel.app
OPENROUTER_APP_TITLE=ai-finance
