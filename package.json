{
  "name": "ai-finance",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "pnpm --filter @ai-finance/web dev",
    "dev:web": "pnpm --filter @ai-finance/web dev",
    "dev:client": "pnpm --filter @ai-finance/client dev",
    "dev:all": "concurrently -n web,client -c cyan,magenta \"pnpm dev:web\" \"pnpm dev:client\"",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @ai-finance/web build",
    "build:client": "pnpm --filter @ai-finance/client build",
    "pack:win": "pnpm --filter @ai-finance/client pack:win",
    "start": "pnpm --filter @ai-finance/web start",
    "lint": "pnpm -r lint",
    "vercel:link": "vercel link",
    "vercel:env:pull": "vercel env pull web/.env.vercel.local",
    "deploy:preview": "vercel deploy --yes",
    "deploy": "vercel deploy --prod --yes",
    "deploy:vercel": "bash scripts/deploy-vercel.sh --prod"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "vercel": "^48.12.1"
  }
}
